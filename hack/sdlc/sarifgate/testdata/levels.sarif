{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {"id": "x/note-by-default", "defaultConfiguration": {"level": "note"}},
            {"id": "x/no-default"},
            {"id": "x/error-by-default", "defaultConfiguration": {"level": "error"}}
          ]
        }
      },
      "results": [
        {
          "ruleId": "x/note-by-default",
          "level": "warning",
          "message": {"text": "The result's level wins over the rule's default."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "a.go"}, "region": {"startLine": 1}}}],
          "partialFingerprints": {"primaryLocationLineHash": "aaa:1"}
        },
        {
          "ruleId": "x/no-default",
          "message": {"text": "No level anywhere: SARIF's default, warning."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "b.go"}, "region": {"startLine": 2}}}],
          "partialFingerprints": {"primaryLocationLineHash": "bbb:1"}
        },
        {
          "ruleId": "x/error-by-default",
          "message": {"text": "No level of its own: the driver rule's default, error."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "c.go"}, "region": {"startLine": 3}}}],
          "partialFingerprints": {"primaryLocationLineHash": "ccc:1"}
        }
      ]
    }
  ]
}
