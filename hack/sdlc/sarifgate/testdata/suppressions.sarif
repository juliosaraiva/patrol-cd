{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {"driver": {"name": "CodeQL", "rules": [{"id": "x/r", "defaultConfiguration": {"level": "error"}}]}},
      "results": [
        {
          "ruleId": "x/r",
          "message": {"text": "Suppressed in the source, no status: accepted."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "a.go"}, "region": {"startLine": 1}}}],
          "partialFingerprints": {"primaryLocationLineHash": "aaa:1"},
          "suppressions": [{"kind": "inSource"}]
        },
        {
          "ruleId": "x/r",
          "message": {"text": "An accepted suppression."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "b.go"}, "region": {"startLine": 2}}}],
          "partialFingerprints": {"primaryLocationLineHash": "bbb:1"},
          "suppressions": [{"kind": "external", "status": "accepted"}]
        },
        {
          "ruleId": "x/r",
          "message": {"text": "A rejected suppression does not suppress."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "c.go"}, "region": {"startLine": 3}}}],
          "partialFingerprints": {"primaryLocationLineHash": "ccc:1"},
          "suppressions": [{"kind": "inSource", "status": "rejected"}]
        },
        {
          "ruleId": "x/r",
          "message": {"text": "A suppression under review does not suppress yet."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "d.go"}, "region": {"startLine": 4}}}],
          "partialFingerprints": {"primaryLocationLineHash": "ddd:1"},
          "suppressions": [{"kind": "external", "status": "underReview"}]
        },
        {
          "ruleId": "x/r",
          "message": {"text": "One accepted suppression among others suppresses."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "e.go"}, "region": {"startLine": 5}}}],
          "partialFingerprints": {"primaryLocationLineHash": "eee:1"},
          "suppressions": [{"kind": "external", "status": "rejected"}, {"kind": "inSource"}]
        }
      ]
    }
  ]
}
