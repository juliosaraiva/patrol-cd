#!/usr/bin/env bash
# git pre-push hook (enable with `make sdlc-git-hooks`): every pushed commit must pass
# hack/sdlc/gate.sh (docs/guides/claude-code-sdlc.md). This is the gate's authority: unlike the
# Claude Code hook, it sees the commits actually being pushed. The Claude Code hook refuses pushes
# while it is not enabled, and refuses --no-verify. A person can bypass it in an emergency with
# `git push --no-verify`.
set -euo pipefail

[[ -x hack/sdlc/gate.sh ]] || exit 0 # a branch from before the gate existed
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[[ $local_sha == "$zero" ]] && continue # a deletion
	hack/sdlc/gate.sh "$local_sha" || status=1
done
exit $status
