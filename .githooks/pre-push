#!/usr/bin/env bash
# git pre-push hook (enable with `make sdlc-git-hooks`): every pushed commit must pass
# hack/sdlc/gate.sh, as for pushes made through Claude Code (docs/guides/claude-code-sdlc.md).
# Bypass for an emergency with `git push --no-verify`.
set -euo pipefail

zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[[ $local_sha == "$zero" ]] && continue # a deletion
	hack/sdlc/gate.sh "$local_sha" || status=1
done
exit $status
